# Local development path (Docker uses file:/app/data/prod.db via docker-compose.yml)
DATABASE_URL=file:./prisma/dev.db

# Required: generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# Optional: only needed if NextAuth can't auto-detect the URL
# AUTH_URL=http://localhost:3000
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

CLOUDFLARE_TUNNEL_TOKEN=

# Sentry error tracking (https://sentry.io → Settings → Client Keys)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: for source map uploads during build
# SENTRY_AUTH_TOKEN=
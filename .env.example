# Local development path (Docker uses file:/app/data/prod.db via docker-compose.yml)
DATABASE_URL=file:./dev.db

# Required: generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# Optional: only needed if NextAuth can't auto-detect the URL
# AUTH_URL=http://localhost:3000
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

CLOUDFLARE_TUNNEL_TOKEN=

# Comma-separated IPs/hostnames allowed to load the dev server (e.g. your phone's IP)
ALLOWED_DEV_ORIGINS=192.168.1.100

# Sentry error tracking (https://sentry.io → Settings → Client Keys)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry org/project slugs (from sentry.io/organizations/<org>/projects/<project>/)
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# Auth token for source map uploads during build (Sentry → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
